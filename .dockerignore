# Ignore version control folders
.git
.gitignore

# Ignore build artifacts and workspace install folders
# .dockerignore
ros_ws/build
ros_ws/install
ros_ws/log

*.ipynb_checkpoints
*.pt

# Ignore local IDE/editor files
.vscode/
.idea/
*.swp
*.swo

# Ignore OS metadata files
.DS_Store
Thumbs.db

# Ignore Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# Ignore any log files
*.log

# Ignore large model or dataset files that should not be in image context
*.onnx
*.h5
*.pt
*.pth

# Ignore basler .deb files if you prefer to copy from host explicitly
